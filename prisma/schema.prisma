// AI Travel Planner — data model
// Mirrors the ER design in the project documentary (Section 19, Table 14):
// users -> user_preferences, trips -> itineraries -> activities, trips -> expenses,
// users -> chat_sessions -> chat_messages.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  // Pooled (pgbouncer, transaction mode) — used for normal app queries.
  url       = env("DATABASE_URL")
  // Direct, non-pooled connection — required for migrations, since
  // pgbouncer's transaction mode doesn't support the prepared statements
  // `prisma migrate` needs. Supabase's recommended Prisma setup.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  preferences  UserPreferences?
  trips        Trip[]
  chatSessions ChatSession[]

  @@map("users")
}

model UserPreferences {
  userId        String   @id @map("user_id")
  travelStyle   String?  @map("travel_style")
  foodPreference String? @map("food_preference")
  interests     String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum TripStatus {
  DRAFT
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Trip {
  id          String     @id @default(cuid())
  userId      String     @map("user_id")
  destination String
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  durationDays Int       @map("duration_days")
  travelers   Int
  budget      Decimal    @db.Decimal(12, 2)
  status      TripStatus @default(DRAFT)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraries  Itinerary[]
  expenses     Expense[]
  chatSessions ChatSession[]

  @@index([userId])
  @@map("trips")
}

model Itinerary {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  dayNumber Int      @map("day_number")
  date      DateTime?
  title     String

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, dayNumber])
  @@map("itineraries")
}

model Activity {
  id             String   @id @default(cuid())
  itineraryId    String   @map("itinerary_id")
  name           String
  location       String?
  startTime      String?  @map("start_time")
  endTime        String?  @map("end_time")
  estimatedCost  Decimal  @default(0) @db.Decimal(12, 2) @map("estimated_cost")
  notes          String?
  sortOrder      Int      @default(0) @map("sort_order")

  itinerary Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@map("activities")
}

enum ExpenseCategory {
  TRANSPORT
  ACCOMMODATION
  FOOD
  ACTIVITIES
  LOCAL_TRANSPORT
  MISCELLANEOUS
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String          @map("trip_id")
  category    ExpenseCategory
  description String?
  amount      Decimal         @db.Decimal(12, 2)
  createdAt   DateTime        @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("expenses")
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tripId    String?  @map("trip_id")
  // Structured trip context extracted from the conversation so far (see
  // Section 14, Conversation and Memory Design). Shape is TripContext
  // (src/lib/ai/trip-context.ts), validated with Zod on every read/write —
  // never trusted as-is since it round-trips through AI-generated JSON.
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip     Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  role      ChatRole
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}
