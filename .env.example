# Local environment variables — gitignored, never commit real secrets here.
# Copy this file's shape into your own values; see .env.example for a template.
#
# Used by both the Next.js app (auto-loaded) and the Prisma CLI (via dotenv/config
# in prisma.config.ts), so DATABASE_URL must live here rather than in .env.local.

# Groq (AI layer, primary)
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio / Gemini (AI layer, automatic fallback when Groq fails
# or is rate-limited — see src/lib/ai/gemini-client.ts). Optional: leave as
# the placeholder to run with Groq only.
GEMINI_API_KEY=your_gemini_api_key_here

# Foursquare Places API — real hotels/homestays with verified addresses and
# map coordinates (src/lib/places/foursquare-client.ts). Optional: without it
# the assistant simply reports it couldn't find verified stays rather than
# inventing hotel names. Only free "Core" fields are used; `rating`/`price`
# are Premium and return 429 on the free tier, so ratings are surfaced via a
# Google Maps link per stay instead.
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# Supabase Postgres connection strings (used by Prisma) — from your
# project's Connect modal, ORM tab, Prisma option. DATABASE_URL is the
# pooled (pgbouncer) connection for normal app queries; DIRECT_URL is the
# non-pooled connection Prisma needs for running migrations.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres

# Auth
AUTH_SECRET=replace_with_a_random_32_byte_secret
