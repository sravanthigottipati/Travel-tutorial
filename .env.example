# Local environment variables — gitignored, never commit real secrets here.
# Copy this file's shape into your own values; see .env.example for a template.
#
# Used by both the Next.js app (auto-loaded) and the Prisma CLI (via dotenv/config
# in prisma.config.ts), so DATABASE_URL must live here rather than in .env.local.

# Groq (AI layer)
GROQ_API_KEY=your_groq_api_key_here

# Supabase Postgres connection string (used by Prisma)
DATABASE_URL=postgresql://user:password@host:5432/postgres?schema=public

# Auth
AUTH_SECRET=replace_with_a_random_32_byte_secret
